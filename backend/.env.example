NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://usports:usports@localhost:5432/usports_fantasy

# Auth: verify bearer JWTs with ONE of these. Tokens' `sub` maps to users.auth_subject.
# JWT_SECRET=change-me-to-at-least-32-random-characters   # HS256
# JWT_JWKS_URL=https://your-idp/.well-known/jwks.json      # RS256/ES256 (Apple, Auth0, Supabase, ...)
# JWT_ISSUER=
# JWT_AUDIENCE=

# Local development only: trust an `X-Dev-User: <subject>` header. Refused when NODE_ENV=production.
AUTH_DEV_HEADER=true
