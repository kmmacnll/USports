# Server-side only: the browser never calls the API directly.
# Base URL of the Express API, including /api/v1.
API_BASE_URL=http://localhost:3000/api/v1

# On Render, render.yaml sets API_HOSTPORT (host:port of the API service on the
# private network). It takes precedence over API_BASE_URL.
# API_HOSTPORT=varsityhq-api:10000

# Local development only (NODE_ENV != production): lets the sign-in page offer
# "continue as <name>", sent to the API as X-Dev-User (the API also needs AUTH_DEV_HEADER=true).
DEV_SIGN_IN=true
